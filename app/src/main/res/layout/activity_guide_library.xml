<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/guideLibraryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eink_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/eink_background">

            <TextView
                android:id="@+id/titleView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:text="@string/guide_library_title"
                android:textColor="@color/eink_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuButton"
                android:layout_width="56dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_library_item"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/menu_dots"
                android:textColor="@color/eink_text"
                android:textSize="22sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/eink_divider" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp" />

            <TextView
                android:id="@+id/emptyView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:padding="32dp"
                android:gravity="center"
                android:text="@string/guide_library_empty"
                android:textColor="@color/eink_text"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

    <!-- Same flat, bordered, no-elevation/ripple button style as the novel library's own
         "+ Import novel", fixed bottom-right regardless of list scroll position. -->
    <TextView
        android:id="@+id/addGuideButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_choice_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/add_guide_button"
        android:textColor="@color/choice_button_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/menuScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/menuPanel"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:padding="2dp"
        android:background="@drawable/bg_menu_panel"
        android:visibility="gone">

        <TextView
            android:id="@+id/menuBackToLibrary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_library_item"
            android:padding="16dp"
            android:text="@string/back_to_novel_list"
            android:textColor="@color/eink_text"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_divider" />

        <TextView
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_library_item"
            android:padding="16dp"
            android:text="@string/settings"
            android:textColor="@color/eink_text"
            android:textSize="16sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/eink_divider" />

        <TextView
            android:id="@+id/menuQuit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_library_item"
            android:padding="16dp"
            android:text="@string/quit"
            android:textColor="@color/eink_text"
            android:textSize="16sp" />
    </LinearLayout>

</FrameLayout>
