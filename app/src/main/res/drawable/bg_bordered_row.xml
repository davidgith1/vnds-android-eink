<?xml version="1.0" encoding="utf-8"?>
<!-- Flat, non-animated pressed-state swap (no ripple) so e-ink screens don't ghost. Same 1px
     border as bg_menu_popup, but per-row rather than around the whole popup. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#EAEAEA" />
            <stroke android:width="1dp" android:color="@color/eink_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/eink_background" />
            <stroke android:width="1dp" android:color="@color/eink_text" />
        </shape>
    </item>
</selector>
